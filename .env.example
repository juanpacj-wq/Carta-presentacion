# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# Public domain — where QR codes and shared links point to.
# In production: https://perfiles.example.com
PUBLIC_BASE_URL=http://localhost:5174

# CORS — include both admin and public origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# --- Autenticacion local (usuario unico) ---
# Nombre de usuario autorizado. Unico. Comparado en minusculas.
AUTH_USERNAME=mpinzon
# Hash scrypt del password. Generar con:
#   npm run hash-password --workspace=server -- '<password>'
# Formato: scrypt$<saltHex>$<hashHex>
AUTH_PASSWORD_HASH=
# Secreto HMAC para firmar las cookies de sesion. Minimo 32 caracteres.
# Generar con: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# En produccion, cargar desde /etc/comunicaciones/env (modo 640) — NUNCA commitear.
SESSION_SECRET=
# TTL de la sesion en horas (default 8).
SESSION_TTL_HOURS=8

# --- Frontend (Vite) ---
# Vite carga estas variables porque vite.config.ts apunta envDir a la raiz.
# URL del dominio publico (se embede en el QR del admin panel).
# En produccion: https://perfiles.example.com
VITE_PUBLIC_BASE_URL=http://localhost:5174

# Database (SQLite)
# Optional. Defaults to <repo>/server/data/comunicaciones.db for local dev.
# In production set an absolute path outside the repo, e.g.:
#   DB_PATH=/var/lib/comunicaciones/comunicaciones.db
# DB_PATH=

# Uploads
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIR=./uploads
